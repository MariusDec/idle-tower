{
  "name": "the-tower",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-new-port": "vite --port 5174",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "esbuild sim/balance.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/sim.mjs --log-level=warning && node node_modules/.tmp/sim.mjs",
    "checks": "esbuild sim/checks.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/checks.mjs --log-level=warning && node node_modules/.tmp/checks.mjs",
    "icons": "node scripts/fetch-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:run": "npm run build && npx cap sync android && npx cap run android",
    "android:dev": "npm run cap:sync && npx cap run android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run cap:sync && cd android && ./gradlew assembleRelease",
    "android:bundle": "npm run cap:sync && cd android && ./gradlew bundleRelease",
    "android:open": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "playwright": "^1.62.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "idb": "^8.0.3",
    "sharp": "^0.32.6"
  },
  "allowScripts": {
    "sharp@0.32.6": true
  }
}
